<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#33243A4A" />
                    <stroke android:width="3dp" android:color="@color/gold" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@color/cyan" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#445FD0E6" />
            <stroke android:width="2dp" android:color="@color/gold" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#22101820" />
            <stroke android:width="1dp" android:color="#665FD0E6" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
