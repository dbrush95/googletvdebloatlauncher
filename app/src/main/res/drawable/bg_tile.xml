<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#335FD0E6" />
            <stroke android:width="1dp" android:color="#E6F7FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#335FD0E6" />
            <stroke android:width="1dp" android:color="#E6F7FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#22101820" />
            <stroke android:width="1dp" android:color="#665FD0E6" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
